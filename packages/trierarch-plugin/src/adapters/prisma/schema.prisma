// The trierarch plugin's tables, in its own small database (decision 0030): per
// fleet only its connection, its switch, its enabled models (decision 0063) and
// its usage history, and the installation's requests.
// Everything else (crew requests, statuses, machines) lives in the fleet, which
// it reaches only through its public API, as the ship it crews.
//
// Timestamps have no database default: the application's Clock port sets every
// one of them, so tests control time.

generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// The crew token the trierarch plugin holds for each fleet's plugin ship, so a
/// restart crews it again without a new secret. One row per fleet: one install
/// serves many fleets.
model Connection {
  fleetId   String   @id @map("fleet_id")
  shipId    String   @map("ship_id")
  shipName  String   @map("ship_name")
  /// Null while the plugin is not connected: the fleet and ship stay, as the last connection.
  crewToken String?  @map("crew_token")
  crewedAt  DateTime @map("crewed_at") @db.Timestamptz(3)

  @@map("connections")
}

/// Whether the hosting service switched the trierarch plugin on for a fleet
/// (decisions 0021, 0030). None before the first switch.
model FleetSwitch {
  fleetId   String   @id @map("fleet_id")
  enabled   Boolean
  changedAt DateTime @map("changed_at") @db.Timestamptz(3)

  @@map("fleet_switches")
}

/// The installation's requests, by the caller's request id, so a replay answers
/// what the first call answered. A switch names its fleet and goes with it; a
/// delete keeps only the request's hash, so nothing of the deleted fleet stays.
model InstallationRequest {
  requestId   String   @id @map("request_id")
  kind        String
  requestHash String   @map("request_hash")
  fleetId     String?  @map("fleet_id")
  enabled     Boolean?
  at          DateTime @db.Timestamptz(3)

  @@index([fleetId])
  @@map("installation_requests")
}

/// The models each fleet's agent ships may be crewed with (decision 0063): exact
/// model ids, one row each. None is no rule. Forgotten with the fleet; switching
/// the trierarch plugin off keeps them.
model EnabledModel {
  fleetId String @map("fleet_id")
  model   String

  @@id([fleetId, model])
  @@map("enabled_models")
}

/// One ship's tokens of one model in one UTC hour, in one folder of the ship on
/// one machine, as its trierarch read them (decision 0030, the usage design). The
/// hour's total so far: a row is kept only when its read_at is newer than the
/// stored one. Its primary key, fleet and hour first, serves a range of hours.
model UsageHour {
  fleetId                    String   @map("fleet_id")
  hour                       DateTime @db.Timestamptz(3)
  machineShipId              String   @map("machine_ship_id")
  shipId                     String   @map("ship_id")
  folderMadeAt               DateTime @map("folder_made_at") @db.Timestamptz(3)
  model                      String
  harness                    String
  /// Null: the trierarch reported no login.
  login                      String?
  input                      BigInt
  output                     BigInt
  cacheRead                  BigInt   @map("cache_read")
  cacheWrite                 BigInt   @map("cache_write")
  /// The estimated cost of each kind of tokens; all four null: the trierarch does not price the model.
  estimatedCostInputUsd      Decimal? @map("estimated_cost_input_usd") @db.Decimal(18, 6)
  estimatedCostOutputUsd     Decimal? @map("estimated_cost_output_usd") @db.Decimal(18, 6)
  estimatedCostCacheReadUsd  Decimal? @map("estimated_cost_cache_read_usd") @db.Decimal(18, 6)
  estimatedCostCacheWriteUsd Decimal? @map("estimated_cost_cache_write_usd") @db.Decimal(18, 6)
  readAt                     DateTime @map("read_at") @db.Timestamptz(3)

  @@id([fleetId, hour, machineShipId, shipId, folderMadeAt, model])
  @@map("usage_hours")
}

/// The hours of one UTC day added up, per machine, ship, model, harness and
/// login: the rollup ranges over 7 days read. Written in the same transaction as
/// each usage_hours row, by the difference between the new and the stored row.
/// Its key holds the login, which may be null, so the migration makes that
/// unique index NULLS NOT DISTINCT, which this schema cannot say.
model UsageDay {
  id                         BigInt   @id @default(autoincrement())
  fleetId                    String   @map("fleet_id")
  day                        DateTime @db.Date
  machineShipId              String   @map("machine_ship_id")
  shipId                     String   @map("ship_id")
  model                      String
  harness                    String
  login                      String?
  input                      BigInt
  output                     BigInt
  cacheRead                  BigInt   @map("cache_read")
  cacheWrite                 BigInt   @map("cache_write")
  /// The estimated cost of each kind of tokens, of the priced hours only.
  estimatedCostInputUsd      Decimal  @map("estimated_cost_input_usd") @db.Decimal(18, 6)
  estimatedCostOutputUsd     Decimal  @map("estimated_cost_output_usd") @db.Decimal(18, 6)
  estimatedCostCacheReadUsd  Decimal  @map("estimated_cost_cache_read_usd") @db.Decimal(18, 6)
  estimatedCostCacheWriteUsd Decimal  @map("estimated_cost_cache_write_usd") @db.Decimal(18, 6)
  /// The tokens of each kind of the hours whose model the trierarch does not price.
  unpricedInput              BigInt   @map("unpriced_input")
  unpricedOutput             BigInt   @map("unpriced_output")
  unpricedCacheRead          BigInt   @map("unpriced_cache_read")
  unpricedCacheWrite         BigInt   @map("unpriced_cache_write")

  @@unique([fleetId, day, machineShipId, shipId, model, harness, login])
  @@map("usage_days")
}

/// How full one subscription window of a harness on one machine was when its
/// trierarch read it. Kept once: a repeat changes nothing.
model SubscriptionReading {
  fleetId       String   @map("fleet_id")
  machineShipId String   @map("machine_ship_id")
  harness       String
  windowMinutes Int      @map("window_minutes")
  readAt        DateTime @map("read_at") @db.Timestamptz(3)
  usedPercent   Decimal  @map("used_percent") @db.Decimal(5, 2)
  resetsAt      DateTime @map("resets_at") @db.Timestamptz(3)

  @@id([fleetId, machineShipId, harness, windowMinutes, readAt])
  @@map("subscription_readings")
}

/// Each fleet's one current MCP configuration (the fleet crew MCP design,
/// section 4): its version, which guards every replacement, and its servers as
/// the model saved them. No row before the fleet's first replacement: version 0
/// with nothing. Its secrets are in mcp_secrets, so this row holds no value.
model McpConfiguration {
  fleetId    String   @id @map("fleet_id")
  version    Int
  servers    Json
  replacedAt DateTime @map("replaced_at") @db.Timestamptz(3)

  @@map("mcp_configurations")
}

/// The secrets of each fleet's MCP configuration, with their values: the
/// plugin's credential store, readable to the service and its database
/// administrators. Replaced with the set, in the same transaction.
model McpSecret {
  fleetId String @map("fleet_id")
  name    String
  value   String

  @@id([fleetId, name])
  @@map("mcp_secrets")
}

/// One row per replacement of a fleet's MCP configuration, written in the same
/// transaction: the version it saved, the console session's kind and account,
/// and the server and secret names it changed. Never a value.
model McpConfigurationEvent {
  id             BigInt   @id @default(autoincrement())
  fleetId        String   @map("fleet_id")
  version        Int
  actorKind      String   @map("actor_kind")
  actorAccountId String?  @map("actor_account_id")
  changedServers String[] @map("changed_servers")
  changedSecrets String[] @map("changed_secrets")
  at             DateTime @db.Timestamptz(3)

  @@unique([fleetId, version])
  @@map("mcp_configuration_events")
}

/// The delivery of a fleet's MCP configuration to one of its trierarch ships
/// (the fleet crew MCP design, section 5): the attempt last made, kept under its
/// idempotency key before it is sent, with the very message, as the fleet takes
/// a key only for one message; the version and key the trierarch confirmed it
/// applied; and whether it asked for the set since. Its secrets are only sealed
/// to the trierarch's key. Forgotten when the trierarch is seen not crewed.
model McpDelivery {
  fleetId               String    @map("fleet_id")
  trierarchShipId       String    @map("trierarch_ship_id")
  attemptVersion        Int?      @map("attempt_version")
  attemptPublicKey      String?   @map("attempt_public_key")
  attemptIdempotencyKey String?   @map("attempt_idempotency_key")
  attemptPayload        String?   @map("attempt_payload")
  /// Null while the fleet is not known to have taken the attempt.
  attemptSentAt         DateTime? @map("attempt_sent_at") @db.Timestamptz(3)
  appliedVersion        Int?      @map("applied_version")
  appliedPublicKey      String?   @map("applied_public_key")
  isRequested           Boolean   @default(false) @map("is_requested")

  @@id([fleetId, trierarchShipId])
  @@map("mcp_deliveries")
}
